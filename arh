set -e
if [ -n "${old_style}" ]; then
	is_parent=1 ~/test/debinit2b "${1}"
else
	ver=`head -1 debian/changelog | grep -Po '(?<=\()[^)]*'`
	ver=`echo ${ver} | sed s/-/./`
	echo ${ver}
	echo -n ${ver} | xclip -sel clip
	mkdir debian/patches
	touch debian/patches/series
	dpkg-source --commit --include-removal
	dch --distribution=bionic -v `ls debian/patches | grep -v series | sed 's/\./-/'`
	~/test/debuild
fi
ppa=exp ~/test/deb
~/test/publp exp
